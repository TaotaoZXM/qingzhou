# Copy to /etc/qingzhou.env and edit. systemd reads this file directly.
# Do not wrap values in quotes.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
SERVE_STATIC=0

DB_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=qingzhou
DB_PASSWORD=change-me
DB_NAME=qingzhou

# At least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Login sessions last 15 days. This value is fixed in the server.

# Leave unset to mark the cookie Secure only when the request is HTTPS.
# Set to 1 after the domain serves HTTPS if you want to force it.
# COOKIE_SECURE=1

# Email. Leave unset or set to anything other than directmail to skip sending.
# The verification and reset links are written to the server log. Production
# never returns those links to the browser. Non-production responses include
# them so the flow can be opened without a mailbox.
# EMAIL_DELIVERY=directmail
# DIRECTMAIL_ACCESS_KEY_ID=
# DIRECTMAIL_ACCESS_KEY_SECRET=
# DIRECTMAIL_ACCOUNT_NAME=noreply@myqingzhou.com
# DIRECTMAIL_FROM_ALIAS=轻舟
# DIRECTMAIL_REGION=cn-hangzhou
# DIRECTMAIL_ADDRESS_TYPE=1
# DIRECTMAIL_ENDPOINT=https://dm.aliyuncs.com/
