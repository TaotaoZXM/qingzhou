# Copy to /etc/qingzhou.env and edit. systemd reads this file directly.
# Do not wrap values in quotes.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
SERVE_STATIC=0

DB_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=qingzhou
DB_PASSWORD=change-me
DB_NAME=qingzhou

# At least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Login sessions last 7 days. This value is fixed in the server.
# Resetting a password revokes sessions already issued for that account.

# Leave unset. Behind nginx, Secure is set only when X-Forwarded-Proto is
# https (trust proxy). http://121.41.63.67/ stays usable during cutover.
# COOKIE_SECURE=1 forces Secure on HTTP too, so the IP login will not stick.
# COOKIE_SECURE=0 never sets Secure. Do not set either on this ECS.

# Leave unset until the values below are filled in on the server.
# Do not commit real keys. Restart qingzhou after editing, then send a real
# message before relying on registration or password reset.
# EMAIL_DELIVERY=directmail
# DIRECTMAIL_ACCESS_KEY_ID=
# DIRECTMAIL_ACCESS_KEY_SECRET=
# Verified From address. EMAIL_FROM is accepted as an alias.
# DIRECTMAIL_ACCOUNT_NAME=noreply@mail.myqingzhou.com
# Hangzhou is the default and posts to https://dm.aliyuncs.com/
# DIRECTMAIL_REGION=cn-hangzhou
# Optional VPC endpoint when ECS is in the same region:
# DIRECTMAIL_ENDPOINT=https://dm-vpc.cn-hangzhou.aliyuncs.com/
# DIRECTMAIL_REPLY_TO=
# Origin for links. A /taskmanager/ suffix is ignored for /api links.
# APP_PUBLIC_URL=https://www.myqingzhou.com

# Local debugging only. Ignored when NODE_ENV=production.
# EXPOSE_DEV_LINKS=1

# Optional admin account. Leave both unset and startup creates nothing.
# Set both together. Setting only one of them stops startup.
# ADMIN_USERNAME is a plain login name, not an email. It is stored in users.email.
# Log in through the existing email field with that exact name.
# Generate the hash on the server (same bcrypt cost as other passwords):
#   cd /opt/qingzhou/server && node scripts/hash-password.js
# Paste only the hash below. Do not commit the password or the hash.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
