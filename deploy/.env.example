# Copy to /etc/qingzhou.env and edit. systemd reads this file directly.
# Do not wrap values in quotes.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
SERVE_STATIC=0

DB_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=qingzhou
DB_PASSWORD=change-me
DB_NAME=qingzhou

# At least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Leave unset to mark the cookie Secure only when the request is HTTPS.
# Set to 1 after the domain serves HTTPS if you want to force it.
# COOKIE_SECURE=1

# Set to log only while wiring password-reset email. It prints the reset link.
# PASSWORD_RESET_DELIVERY=log
